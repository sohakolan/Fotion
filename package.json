{
  "name": "fotion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:architecture && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:ui": "npm run build && node scripts/check-ui.mjs",
    "test:browser": "npm run build && playwright test",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "@tiptap/core": "latest",
    "@tiptap/extension-code-block": "^3.32.1",
    "@tiptap/extension-image": "latest",
    "@tiptap/extension-placeholder": "latest",
    "@tiptap/extension-table": "latest",
    "@tiptap/extension-task-item": "latest",
    "@tiptap/extension-task-list": "latest",
    "@tiptap/markdown": "latest",
    "@tiptap/pm": "latest",
    "@tiptap/starter-kit": "latest",
    "emojibase-data": "^18.0.0",
    "lowlight": "^3.3.0",
    "lucide-solid": "latest",
    "marked": "^17.0.6",
    "solid-js": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "jsdom": "latest",
    "rolldown": "^1.2.16",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-solid": "latest"
  }
}
